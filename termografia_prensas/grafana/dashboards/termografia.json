    {
      "id": 4,
      "type": "stat",
      "title": "Temperatura promedio",
      "datasource": {
        "type": "postgres",
        "uid": "termografia-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 5,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "termografia-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT AVG(temp_media) AS \"Promedio\" FROM lecturas WHERE ciclo_id = (SELECT CASE WHEN $ciclo = 0 THEN MAX(id) ELSE $ciclo END FROM ciclos) AND ts = (SELECT MAX(ts) FROM lecturas WHERE ciclo_id = (SELECT CASE WHEN $ciclo = 0 THEN MAX(id) ELSE $ciclo END FROM ciclos))",
