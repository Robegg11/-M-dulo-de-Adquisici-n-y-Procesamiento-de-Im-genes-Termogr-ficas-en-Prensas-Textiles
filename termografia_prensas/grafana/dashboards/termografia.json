          "rawQuery": true,
          "rawSql": "WITH u AS (SELECT temp_media AS t FROM lecturas WHERE ciclo_id = (SELECT CASE WHEN $ciclo = 0 THEN MAX(id) ELSE $ciclo END FROM ciclos) AND roi = 'centro' ORDER BY ts DESC LIMIT 1) SELECT CASE WHEN ((t >= $rojo_min AND t <= $rojo_max) AND NOT (t >= $naranja_min AND t <= $naranja_max AND (t >= $rojo_min AND t <= $rojo_max))) THEN 1 ELSE 0 END AS \"Estado\" FROM u",
