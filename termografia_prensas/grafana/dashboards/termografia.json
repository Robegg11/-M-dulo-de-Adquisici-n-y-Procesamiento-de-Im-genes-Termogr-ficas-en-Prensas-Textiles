    {
      "id": 5,
      "type": "marcusolsson-dynamictext-panel",
      "title": "Frame térmico del ciclo",
      "datasource": {
        "type": "postgres",
        "uid": "termografia-pg"
      },
      "gridPos": {
        "x": 5,
        "y": 3,
        "w": 14,
        "h": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "termografia-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT frame_img AS frame FROM ciclos WHERE id = (SELECT CASE WHEN $ciclo = 0 THEN MAX(id) ELSE $ciclo END FROM ciclos)",
          "refId": "A"
        }
      ],
      "options": {
        "renderMode": "allRows",
        "content": "<div style='display:flex;justify-content:center;align-items:center'>{{#each data}}<img src='{{{frame}}}' style='max-height:430px;max-width:100%;object-fit:contain' alt='Frame térmico'/>{{/each}}</div>",
        "defaultContent": "<p style='text-align:center'>Sin imagen para este ciclo</p>",
        "styles": "",
        "helpers": "",
        "afterRender": "",
        "wrap": true
      }
    },
    {
      "id": 6,
      "type": "trend",
      "title": "Temperatura en tiempo real (segundos desde el inicio del ciclo)",
      "datasource": {
        "type": "postgres",
        "uid": "termografia-pg"
      },
      "gridPos": {
        "x": 5,
        "y": 19,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "termografia-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT EXTRACT(EPOCH FROM (l.ts - c.inicio))::float AS \"Segundos\", MAX(CASE WHEN l.roi = 'centro' THEN l.temp_media END) AS \"centro\", MAX(CASE WHEN l.roi = 'borde_izq' THEN l.temp_media END) AS \"borde_izq\", MAX(CASE WHEN l.roi = 'borde_der' THEN l.temp_media END) AS \"borde_der\", MAX(CASE WHEN l.roi = 'borde_sup' THEN l.temp_media END) AS \"borde_sup\", MAX(CASE WHEN l.roi = 'borde_inf' THEN l.temp_media END) AS \"borde_inf\" FROM lecturas l JOIN ciclos c ON c.id = l.ciclo_id WHERE l.ciclo_id = (SELECT CASE WHEN $ciclo = 0 THEN MAX(id) ELSE $ciclo END FROM ciclos) GROUP BY l.ts, c.inicio ORDER BY l.ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Segundos"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Alerta · Verde",
      "datasource": {
        "type": "postgres",
        "uid": "termografia-pg"
      },
      "gridPos": {
        "x": 19,
        "y": 3,
        "w": 5,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "termografia-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH u AS (SELECT temp_media AS t FROM lecturas WHERE ciclo_id = (SELECT CASE WHEN $ciclo = 0 THEN MAX(id) ELSE $ciclo END FROM ciclos) AND roi = 'centro' ORDER BY ts DESC LIMIT 1) SELECT CASE WHEN (t >= $naranja_min AND t <= $naranja_max AND (t >= $rojo_min AND t <= $rojo_max)) THEN 1 ELSE 0 END AS \"Estado\" FROM u",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "SEGURO: continuar con la impresión",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "—",
                  "color": "#2b2d33",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
